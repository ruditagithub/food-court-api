PORT=3000
NODE_ENV=development

# MySQL Database Configuration (Separated)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_court

# JWT Authentication
JWT_SECRET=super_secret_food_court_jwt_key_change_me_in_production

# Midtrans (Sandbox keys: https://dashboard.sandbox.midtrans.com > Settings > Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# Mailer (Gmail SMTP - Free, no credit card needed)
# Buat Google App Password di https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FoodCourt OS <no-reply@amici.food>"
FRONTEND_URL=http://localhost:5173